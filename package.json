    "typecheck": "pnpm -r typecheck",
    "start": "node packages/cli/dist/index.js open examples/donut"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.20.5",
    "vitest": "^4.1.11"
  }
}
