{
  "name": "glimpse-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Glimpse — the visual editing layer between you and your AI coding agent.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
