{
  "name": "glimpse-ui",
  "version": "0.1.0",
  "description": "Glimpse \u2014 see what your AI built, edit it visually, hand the changes back.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "glimpse": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-editor.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@glimpse/core": "workspace:*",
    "@glimpse/server": "workspace:*",
    "@glimpse/mcp": "workspace:*"
  },
  "devDependencies": {
    "@glimpse/editor": "workspace:*"
  }
}
